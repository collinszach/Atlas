# ============================================================
# Atlas — Environment Variables
# Copy this file to .env and fill in each value.
# Never commit .env to git.
# ============================================================

# ------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# These are used by both docker-compose and the backend.
# Pick a strong password for POSTGRES_PASSWORD — it only needs
# to work inside the Docker network.
# ------------------------------------------------------------
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://atlas:changeme@atlas-db:5432/atlas
DATABASE_URL_SYNC=postgresql+psycopg2://atlas:changeme@atlas-db:5432/atlas

# ------------------------------------------------------------
# Redis
# No changes needed unless you move Redis off the default port.
# ------------------------------------------------------------
REDIS_URL=redis://atlas-redis:6379/0

# ------------------------------------------------------------
# Clerk (auth)
# Dashboard: https://dashboard.clerk.com → your app → API Keys
#   CLERK_SECRET_KEY          — "Secret keys" section (sk_live_...)
#   CLERK_WEBHOOK_SECRET      — Webhooks → your endpoint → Signing Secret
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY — "Publishable key" (pk_live_...)
# ------------------------------------------------------------
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...

# ------------------------------------------------------------
# MinIO (photo storage)
# Change MINIO_ACCESS_KEY / MINIO_SECRET_KEY from the defaults.
# MINIO_PUBLIC_URL must be the public-facing URL that browsers
# use to load photos — set to your Cloudflare tunnel URL in prod.
# ------------------------------------------------------------
MINIO_ENDPOINT=atlas-minio:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme_secret
MINIO_BUCKET_PHOTOS=atlas-photos
MINIO_LICENSE_KEY=
STORAGE_BACKEND=minio

# Local dev:
# MINIO_PUBLIC_URL=http://localhost:9000
# Production (Cloudflare tunnel):
MINIO_PUBLIC_URL=https://photos.yourdomain.com

# ------------------------------------------------------------
# Cloudflare Tunnel
# Zero Trust → Tunnels → atlas-nuc → token
# The token is the long string after "--token" in the install command.
# ------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------
# Frontend — API base URL
# Local dev:    http://localhost:8010
# Production:   https://api.zacharyjcollins.com
# This is read at build time by Next.js (NEXT_PUBLIC_ prefix).
# ------------------------------------------------------------
NEXT_PUBLIC_API_BASE=https://api.yourdomain.com

# ------------------------------------------------------------
# Protomaps (map tiles)
# Free API key: https://app.protomaps.com
# Used by the MapLibre map for base tiles + country boundaries.
# ------------------------------------------------------------
NEXT_PUBLIC_PROTOMAPS_KEY=

# ------------------------------------------------------------
# Anthropic (AI destination recommendations)
# https://console.anthropic.com → API Keys
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
# AviationStack (optional — flight auto-enrichment)
# https://aviationstack.com → Dashboard → API Access Key
# Leave blank to disable flight lookup (manual entry still works).
# ------------------------------------------------------------
AVIATIONSTACK_API_KEY=

# ------------------------------------------------------------
# Skywatch (Phase 1+)
# ------------------------------------------------------------
# Network ADS-B source. airplanes.live now gates its free API behind manual
# project approval and returns 403 without it. api.adsb.lol is open, needs no
# key, and serves the identical {"ac": [...]} schema — a drop-in replacement.
AIRPLANES_LIVE_BASE=https://api.adsb.lol/v2
# AIRPLANES_LIVE_BASE=https://api.airplanes.live/v2   # requires approval

# Optional: local dump1090/readsb aircraft.json (preferred when available).
# With the compose profile below, the receiver runs alongside the stack:
#   DUMP1090_URL=http://atlas-dump1090:8080/data/aircraft.json
# Or point at a receiver elsewhere on Tailscale.
DUMP1090_URL=

# History collection. The watcher only records while a user's device reports a
# fresh location, so the corpus stops growing when the app is closed. These are
# fixed sites polled on a schedule regardless — "lat,lon; lat,lon". Empty
# disables it. Budget roughly 430k rows/day per site over busy airspace at the
# default 60s interval; retention is SKYWATCH_TRACK_RETENTION_DAYS.
SKYWATCH_COLLECT_SITES=
SKYWATCH_COLLECT_SECONDS=60
SKYWATCH_TRACK_RADIUS_KM=120
SKYWATCH_TRACK_RETENTION_DAYS=30

# Only needed when running the atlas-dump1090 profile (receiver siting).
SDR_LAT=
SDR_LON=
SDR_GAIN=autogain
SKYWATCH_DEFAULT_RADIUS_KM=30
# Watcher polling interval (seconds) and device-location freshness window (minutes)
SKYWATCH_POLL_SECONDS=20
SKYWATCH_LOCATION_FRESHNESS_MINUTES=15
# APNs push (Phase 3 — leave unset until Apple Developer key is provisioned)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
APP_ENV=production
